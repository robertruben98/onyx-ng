{
  "name": "ui-tokens",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/ui/tokens",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node libs/ui/tokens/build.mjs && node libs/ui/tokens/reference.mjs"
      },
      "outputs": [
        "{workspaceRoot}/libs/ui/tokens/dist",
        "{workspaceRoot}/apps/docs/src/app/tokens/token-reference.generated.ts"
      ]
    }
  }
}
